%%{init: {'themeVariables': {'fontFamily': 'Red Hat Text'}}}%%
flowchart TD
  subgraph App["packages/ (Backstage app)"]
    Frontend["packages/app<br/>(React SPA)"]
    Backend["packages/backend<br/>(backend.add modules)"]
  end

  subgraph Common["Shared library"]
    Common1["backstage-rhaap-common<br/>AAPClient, ansibleServiceRef,<br/>types, permissions"]
    ContentCommon["content-development-common<br/>SCM client and EE lifecycle contracts"]
  end

  subgraph FrontendPlugins["Frontend plugins"]
    RhaapFE["backstage-rhaap<br/>AnsiblePage sidebar/pages"]
    SelfService["portal-scaffolder<br/>Templates, EE builder,<br/>Collections, Git repos"]
  end

  subgraph BackendModules["Backend modules"]
    CatalogMod["catalog-backend-module-rhaap<br/>Entity providers"]
    AapScaffolderMod["scaffolder-backend-module-aap<br/>AAP actions and autocomplete"]
    ContentDevelopmentScaffolderMod["content-development scaffolder module<br/>Creator and EE actions"]
    ContentDevelopmentCatalogMod["content-development catalog module<br/>EE provider"]
    AuthMod["auth-backend-module-rhaap-provider<br/>AAP OAuth"]
  end

  AAP[("Ansible Automation<br/>Platform (AAP)")]

  Backend --> CatalogMod
  Backend --> AapScaffolderMod
  Backend --> ContentDevelopmentScaffolderMod
  Backend --> ContentDevelopmentCatalogMod
  Backend --> AuthMod

  RhaapFE -. proxy/API routes .-> Backend
  SelfService -. proxy/API routes .-> Backend
  Frontend --> RhaapFE
  Frontend --> SelfService

  CatalogMod --> Common1
  AapScaffolderMod --> Common1
  CatalogMod --> ContentCommon
  ContentDevelopmentScaffolderMod --> ContentCommon
  ContentDevelopmentCatalogMod --> ContentCommon
  AuthMod --> Common1

  Common1 -->|HTTP| AAP

  style Common1 fill:#fff2cc,stroke:#d6b656
  style AAP fill:#dae8fc,stroke:#6c8ebf
