{
  "name": "@ansible/plugin-backstage-rhaap-app-auth",
  "description": "RHAAP sign-in page and OAuth2 API registered against the app plugin for the Backstage New Frontend System (RHDH 2.1+)",
  "version": "2.2.8",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin-module",
    "pluginId": "app",
    "pluginPackages": [
      "@ansible/plugin-backstage-rhaap-app-auth"
    ]
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "rhdh-cli plugin export"
  },
  "dependencies": {
    "@ansible/plugin-backstage-self-service": "workspace:^",
    "@backstage/core-compat-api": "^0.5.11",
    "@backstage/core-components": "^0.18.8",
    "@backstage/core-plugin-api": "^1.12.4",
    "@backstage/frontend-plugin-api": "^0.17.1",
    "@backstage/plugin-app-react": "^0.2.3"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3"
  },
  "files": [
    "dist",
    "dist-scalprum"
  ]
}
