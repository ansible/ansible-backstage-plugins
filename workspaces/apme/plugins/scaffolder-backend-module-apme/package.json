{
  "name": "@ansible/scaffolder-backend-module-apme",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --embed-package @ansible/backstage-apme-common --embed-package @ansible/backstage-rhaap-common --embed-package @ansible/portal-plugin-node --embed-package @ansible/portal-extension-common"
  },
  "dependencies": {
    "@ansible/backstage-apme-common": "workspace:^",
    "@ansible/portal-plugin-node": "workspace:^",
    "@backstage/backend-plugin-api": "1.10.0",
    "@backstage/catalog-model": "1.10.0",
    "@backstage/errors": "1.3.1",
    "@backstage/plugin-scaffolder-node": "0.13.6"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "1.11.6",
    "@backstage/cli": "0.36.5"
  }
}
