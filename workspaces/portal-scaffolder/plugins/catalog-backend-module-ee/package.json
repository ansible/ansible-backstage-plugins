{
  "name": "@ansible/backstage-plugin-catalog-backend-module-ee",
  "description": "Execution environment definition catalog surface for portal-scaffolder (pluginId catalog).",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --embed-package @ansible/backstage-plugin-catalog-backend-module-rhaap-shared --embed-package @ansible/backstage-rhaap-common --embed-package @ansible/portal-plugin-node --embed-package @ansible/portal-extension-common"
  },
  "dependencies": {
    "@ansible/backstage-plugin-catalog-backend-module-rhaap-shared": "workspace:^",
    "@ansible/backstage-rhaap-common": "workspace:^",
    "@backstage/backend-plugin-api": "1.10.0",
    "@backstage/plugin-catalog-backend": "3.9.1"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.5"
  },
  "files": [
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**",
    "dist-dynamic/alpha/*",
    "build",
    "src/**/*.d.ts"
  ],
  "configSchema": "config.d.ts"
}
