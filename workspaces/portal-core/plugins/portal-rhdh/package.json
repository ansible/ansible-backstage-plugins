{
  "name": "@ansible/portal-rhdh",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Optional native RHDH profile-menu integration for Portal contributions",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "portal-rhdh",
    "features": {
      "./alpha": "@backstage/FrontendPlugin"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --no-generate-scalprum-assets"
  },
  "dependencies": {
    "@ansible/portal-extension-host": "workspace:^",
    "@ansible/portal-plugin-sdk": "workspace:^",
    "@backstage/core-compat-api": "0.5.11",
    "@backstage/frontend-plugin-api": "0.18.0",
    "@red-hat-developer-hub/backstage-plugin-global-header": "3.2.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@ansible/portal-extension-api": "workspace:^",
    "@backstage/cli": "0.36.2",
    "@backstage/core-plugin-api": "1.12.4",
    "@backstage/frontend-test-utils": "0.5.2",
    "@backstage/plugin-app-react": "0.2.8",
    "@backstage/test-utils": "1.7.23",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3"
  },
  "files": [
    "dist"
  ]
}
