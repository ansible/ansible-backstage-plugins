{
  "name": "@ansible/portal-extension-api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Extension contracts SDK for Ansible portal plugins — types, registry, hooks, and helpers for contributing tabs, cards, and actions",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "web-library"
  },
  "sideEffects": false,
  "dependencies": {
    "@ansible/portal-extension-common": "workspace:^",
    "@backstage/frontend-plugin-api": "0.18.0"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "peerDependencies": {
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/plugin-permission-common": "^0.9.10",
    "@backstage/plugin-scaffolder-react": "^2.0.3",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@backstage/catalog-model": "1.10.0",
    "@backstage/cli": "0.36.5",
    "@backstage/config": "1.3.8",
    "@backstage/core-plugin-api": "1.12.9",
    "@backstage/plugin-permission-common": "0.9.10",
    "@backstage/plugin-scaffolder-react": "2.0.3",
    "@backstage/test-utils": "1.7.21",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "files": [
    "dist"
  ]
}
