{
  "name": "@ansible/plugin-automation-content-backend",
  "version": "0.1.0",
  "description": "Content management API for Ansible Automation Portal: discovery, documentation and requirements resolution over OCI-backed Ansible content.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "automation-content"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "export-dynamic": "rhdh-cli plugin export --embed-package @ansible/automation-content-common --embed-package @ansible/content-model --embed-package @ansible/plugin-catalog-backend-module-automation-content --embed-package @ansible/content-type-execution-environment"
  },
  "files": [
    "dist",
    "dist-dynamic"
  ],
  "dependencies": {
    "@ansible/automation-content-common": "workspace:^",
    "@ansible/content-model": "workspace:^",
    "@ansible/content-type-execution-environment": "workspace:^",
    "@ansible/plugin-catalog-backend-module-automation-content": "workspace:^",
    "@backstage/backend-plugin-api": "^1.10.0",
    "express": "^4.21.0",
    "express-promise-router": "^4.1.1"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@red-hat-developer-hub/cli": "^1.10.2",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
