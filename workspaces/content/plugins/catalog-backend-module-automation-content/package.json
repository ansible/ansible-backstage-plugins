{
  "name": "@ansible/plugin-catalog-backend-module-automation-content",
  "version": "0.1.0",
  "description": "Backstage catalog entity provider that discovers Ansible automation content from OCI-compliant registries.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "export-dynamic": "rhdh-cli plugin export --embed-package @ansible/automation-content-common --embed-package @ansible/content-model --embed-package @ansible/content-type-execution-environment"
  },
  "files": [
    "dist",
    "dist-dynamic",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "dependencies": {
    "@ansible/automation-content-common": "workspace:^",
    "@ansible/content-model": "workspace:^",
    "@ansible/content-type-execution-environment": "workspace:^",
    "@backstage/backend-plugin-api": "^1.10.0",
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/config": "^1.3.0",
    "@backstage/plugin-catalog-node": "^2.2.4"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@red-hat-developer-hub/cli": "^1.10.2"
  }
}
