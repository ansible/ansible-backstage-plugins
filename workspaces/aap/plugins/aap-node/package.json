{
  "name": "@ansible/aap-node",
  "description": "AAP backend contracts, reusable HTTP client and helpers",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "backstage": {
    "role": "node-library"
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@ansible/aap-common": "workspace:^",
    "@backstage/backend-plugin-api": "1.10.0",
    "@backstage/config": "1.3.8",
    "@backstage/errors": "1.3.1",
    "@backstage/integration": "2.1.1",
    "@backstage/plugin-auth-node": "0.7.5",
    "lodash.uniqby": "^4.7.0",
    "undici": "^6.26.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "1.11.6",
    "@backstage/cli": "^0.36.0",
    "@jest/globals": "^30.1.2",
    "@types/lodash.uniqby": "^4",
    "typescript": "~5.8.0"
  },
  "files": [
    "dist",
    "src/**/*.d.ts",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
