{
  "name": "@ansible/backstage-plugin-catalog-backend-module-aap",
  "description": "AAP identity and job-template catalog providers for the catalog plugin.",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --embed-package @ansible/backstage-rhaap-common --embed-package @ansible/aap-common --embed-package @ansible/aap-node --embed-package @ansible/portal-plugin-node --embed-package @ansible/portal-extension-common --embed-package @ansible/content-development-common --embed-package @ansible/automation-content-common --embed-package @ansible/content-model"
  },
  "dependencies": {
    "@ansible/aap-common": "workspace:^",
    "@ansible/aap-node": "workspace:^",
    "@ansible/backstage-rhaap-common": "workspace:^",
    "@backstage/backend-plugin-api": "1.10.0",
    "@backstage/plugin-catalog-backend": "3.9.1"
  },
  "devDependencies": {
    "@ansible/backstage-plugin-catalog-backend-module-content": "workspace:^",
    "@backstage/backend-test-utils": "1.11.6",
    "@backstage/cli": "0.36.5",
    "@backstage/config-loader": "1.11.2",
    "@backstage/plugin-signals-node": "0.2.4"
  },
  "files": [
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**",
    "dist-dynamic/alpha/*",
    "build",
    "src/**/*.d.ts"
  ],
  "configSchema": "config.d.ts"
}
