{
  "name": "@ansible/aap-app-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Independent AAP authentication module for the Portal app",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "configSchema": "config.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin-module",
    "pluginId": "app",
    "features": {
      "./alpha": "@backstage/FrontendModule"
    },
    "pluginPackages": [
      "@ansible/aap-app-auth"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --no-generate-scalprum-assets"
  },
  "dependencies": {
    "@ansible/portal-extension-api": "workspace:^",
    "@backstage/core-app-api": "1.19.6",
    "@backstage/core-compat-api": "0.5.11",
    "@backstage/core-components": "0.18.8",
    "@backstage/core-plugin-api": "1.12.4",
    "@backstage/frontend-plugin-api": "0.17.1",
    "@backstage/plugin-app-react": "0.2.3",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.2",
    "@backstage/config": "1.3.6",
    "@backstage/frontend-test-utils": "0.5.2",
    "@backstage/test-utils": "1.7.18",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/react": "18.3.23",
    "typescript": "5.8.3"
  },
  "files": [
    "dist",
    "config.d.ts"
  ]
}
