{
  "name": "@ansible/plugin-scaffolder-backend-module-aap",
  "version": "2.2.9",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --embed-package @ansible/backstage-rhaap-common"
  },
  "dependencies": {
    "@ansible/backstage-rhaap-common": "workspace:^",
    "@backstage/backend-dynamic-feature-service": "0.8.2",
    "@backstage/backend-plugin-api": "1.8.0",
    "@backstage/errors": "1.2.7",
    "@backstage/plugin-scaffolder-node": "0.13.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.2",
    "@types/jest": "29.5.14"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "files": [
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**",
    "dist-dynamic/alpha/*",
    "build",
    "src/**/*.d.ts"
  ]
}
