{
  "name": "@ansible/plugin-scaffolder-backend-module-aap",
  "version": "2.2.9",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --embed-package @ansible/aap-common --embed-package @ansible/backstage-rhaap-common"
  },
  "dependencies": {
    "@ansible/backstage-rhaap-common": "workspace:^",
    "@backstage/backend-dynamic-feature-service": "0.8.6",
    "@backstage/backend-plugin-api": "1.10.0",
    "@backstage/config": "1.3.8",
    "@backstage/errors": "1.3.1",
    "@backstage/plugin-scaffolder-node": "0.13.6",
    "@backstage/types": "1.2.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "1.11.6",
    "@backstage/cli": "0.36.2",
    "@backstage/plugin-scaffolder-node-test-utils": "0.3.16",
    "@types/jest": "29.5.14"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "files": [
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**",
    "dist-dynamic/alpha/*",
    "build",
    "src/**/*.d.ts"
  ],
  "configSchema": "config.d.ts"
}
