{
  "name": "@ansible/backstage-plugin-catalog-backend-module-rhaap-user-provisioner",
  "description": "Catalog backend module providing JIT user provisioning for the RHAAP auth provider.",
  "version": "1.0.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "fix": "backstage-cli repo fix --publish",
    "export-dynamic": "yarn run -T rhdh-cli plugin export --embed-package @ansible/backstage-rhaap-common"
  },
  "dependencies": {
    "@ansible/backstage-rhaap-common": "workspace:^",
    "@backstage/backend-plugin-api": "1.10.0",
    "@backstage/catalog-model": "1.10.0",
    "@backstage/errors": "1.3.1",
    "@backstage/plugin-catalog-node": "2.2.4"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "1.11.6",
    "@backstage/cli": "0.36.5",
    "@backstage/config": "1.3.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4"
  },
  "files": [
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**",
    "dist-dynamic/alpha/*",
    "build",
    "src/**/*.d.ts"
  ],
  "configSchema": "config.d.ts"
}
