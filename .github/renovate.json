{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ansible/actions//config/renovate.json",
    ":gitSignOff",
    ":preserveSemverRanges"
  ],
  "automerge": false,
  "baseBranchPatterns": ["main"],
  "labels": ["dependency", "skip-changelog"],
  "ignorePaths": ["**/dist-dynamic/**"],
  "major": {
    "dependencyDashboardApproval": true
  },
  "npm": {
    "minimumReleaseAge": "1 day"
  },
  "prCreation": "status-success",
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "digest": {
        "enabled": false
      }
    },
    {
      "description": "Portal PR labels on dependency updates",
      "matchPackageNames": ["*"],
      "addLabels": ["dependency", "skip-changelog"]
    },
    {
      "description": "Group non-major security updates with the weekly dependency PR when possible",
      "matchUpdateTypes": ["patch", "minor"],
      "matchCategories": ["security"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  },
  "osvVulnerabilityAlerts": true
}
